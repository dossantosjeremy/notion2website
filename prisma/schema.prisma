generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  notionUserId        String?   @unique
  name                String?
  email               String?
  emailVerified       DateTime?
  image               String?
  notionWorkspaceId   String?
  notionWorkspaceName String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sites    Site[]
  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id                  String    @id @default(cuid())
  userId              String
  rootNotionPageId    String
  rootNotionPageTitle String?
  title               String
  slug                String    @unique
  theme               String    @default("minimal")
  themeSuggested      String?
  published           Boolean   @default(false)
  publishedAt         DateTime?
  lastSyncedAt        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages Page[]

  @@index([slug])
  @@index([userId])
}

model Page {
  id            String   @id @default(cuid())
  siteId        String
  notionPageId  String
  parentPageId  String?
  title         String
  slug          String
  order         Int      @default(0)
  depth         Int      @default(0)
  blocksJson    String?
  coverImageUrl String?
  iconEmoji     String?
  iconImageUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, notionPageId])
  @@unique([siteId, slug])
  @@index([siteId, parentPageId])
}
